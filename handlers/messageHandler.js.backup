export async function messageHandler(sock, msg) {
  if (!msg.message) return;

  const jid = msg.key.remoteJid;
  const sender = msg.key.participant || msg.key.remoteJid;
  const text = msg.message.conversation || msg.message.extendedTextMessage?.text || "";

  // ============================================
  // ðŸ“Š ØªØªØ¨Ø¹ Ø§Ù„Ø±Ø³Ø§Ø¦Ù„ Ø§Ù„ÙŠÙˆÙ…ÙŠØ© ÙÙŠ Ø§Ù„Ù‚Ø±ÙˆØ¨ Ø§Ù„Ø£Ø³Ø§Ø³ÙŠ
  // ============================================
  let kingdom;
  let kingdomData;
  
  try {
    const { getKingdomIdFromGroupJid } = await import('../config.js');
    const { KINGDOMS } = await import('../config.js');
    kingdom = getKingdomIdFromGroupJid(jid);
    kingdomData = KINGDOMS[kingdom];

    // ØªØªØ¨Ø¹ Ø§Ù„Ø±Ø³Ø§Ø¦Ù„ ÙÙ‚Ø· ÙÙŠ Ø§Ù„Ù‚Ø±ÙˆØ¨ Ø§Ù„Ø£Ø³Ø§Ø³ÙŠ
    if (kingdomData && kingdomData.mainGroup === jid && !msg.key.fromMe) {
      try {
        let user = await User.findOne({ jid: sender, kingdom_id: kingdom });

        if (user) {
          // ÙØ­Øµ Ù‡Ù„ Ø§Ù„ÙŠÙˆÙ… Ù…Ø®ØªÙ„Ù Ø¹Ù† Ø§Ù„ÙŠÙˆÙ… Ø§Ù„Ø£Ø®ÙŠØ±
          const today = new Date();
          today.setHours(0, 0, 0, 0);

          const lastReset = new Date(user.lastMessageResetDate || new Date());
          lastReset.setHours(0, 0, 0, 0);

          // Ø­ÙØ¸ Ø§Ù„Ù‚ÙŠÙ…Ø© Ø§Ù„Ø³Ø§Ø¨Ù‚Ø©
          const prevDailyMessages = user.dailyMessages || 0;
          // ðŸ”„ Ø¥Ø¹Ø§Ø¯Ø© ØªØ¹ÙŠÙŠÙ† Ø§Ù„Ø±Ø³Ø§Ø¦Ù„ ÙÙŠ ÙŠÙˆÙ… Ø¬Ø¯ÙŠØ¯
          if (today.getTime() !== lastReset.getTime()) {
            user.dailyMessages = 1;
            user.lastMessageResetDate = new Date();
          } else {
            // Ø¥Ø¶Ø§ÙØ© Ø±Ø³Ø§Ù„Ø© Ø¬Ø¯ÙŠØ¯Ø© Ù„Ù†ÙØ³ Ø§Ù„ÙŠÙˆÙ…
            user.dailyMessages = prevDailyMessages + 1;
          }

          // âœ… Ø­ÙØ¸ ÙÙˆØ±ÙŠ Ù„Ù„Ø¨ÙŠØ§Ù†Ø§Øª
          await user.save();
          console.log(`ðŸ“Š [${user.nickname}] Ø±Ø³Ø§Ø¦Ù„ Ø§Ù„ÙŠÙˆÙ…: ${user.dailyMessages}`);

          // Ø¥Ø´Ø¹Ø§Ø± ØªÙ„Ù‚Ø§Ø¦ÙŠ Ø¹Ù†Ø¯ Ø§Ù„ÙˆØµÙˆÙ„ Ø¥Ù„Ù‰ Ø´ÙˆØ· Ø¬Ø¯ÙŠØ¯ (ÙƒÙ„ 100 ØªÙØ§Ø¹Ù„)
